<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="#0D1A2B">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🧠 ProjectMind" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="LIVE" android:textColor="#39D49A" android:textStyle="bold" android:textSize="9sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Project Intelligence · Command Center" android:textColor="#91A4BA" android:textSize="10sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="9dp">
        <TextView android:id="@+id/widget_delayed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🔴 0 Delayed" android:textColor="#FF6B80" android:textSize="12sp"/>
        <TextView android:id="@+id/widget_risk" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="🟠 0 At Risk" android:textColor="#FFC454" android:textSize="12sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <TextView android:id="@+id/widget_critical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="⚡ Critical: 0" android:textColor="#5791FF" android:textSize="11sp"/>
        <TextView android:id="@+id/widget_attention" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="⚠ Attention: 0" android:textColor="#FFC454" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="Progress: 0%" android:textColor="#39D49A" android:textSize="11sp"/>
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:text="Tap to open ProjectMind" android:textColor="#5791FF" android:textSize="10sp"/>
</LinearLayout>